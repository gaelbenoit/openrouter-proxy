# Proxy Configuration
PROXY_HOST=127.0.0.1
PROXY_PORT=8899

# Target OpenRouter Configuration
TARGET_HOST=openrouter.ai
TARGET_PORT=443
TARGET_PROTOCOL=https

# API Keys (comma-separated list)
API_KEYS=your-key-1,your-key-2

# Header Injection Values
HTTP_REFERER=https://github.com/openrouter
OPENROUTER_TITLE=OpenRouter Proxy

# Feature Toggles
VERBOSE_LOGGING=false
KEY_FAILURE_THRESHOLD=3